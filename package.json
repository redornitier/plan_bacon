{
  "name": "plan-bacon",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "demo": "tsx scripts/demo.ts",
    "maintain": "tsx scripts/maintain.ts",
    "preview": "vite preview --host 127.0.0.1",
    "configure:production": "tsx scripts/configure-production.ts",
    "deploy:dry": "tsx scripts/publish.ts --dry-run",
    "deploy": "tsx scripts/publish.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20260730.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  },
  "packageManager": "pnpm@11.25.0"
}
