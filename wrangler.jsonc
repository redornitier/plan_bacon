{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plan-bacon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "plan-bacon",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations", "remote": false
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "plan-bacon-photos", "remote": false }],
  "images": { "binding": "IMAGES", "remote": false },
  "vars": { "RESTAURANT_ID": "el-volante" },
  "observability": { "enabled": true }
}
